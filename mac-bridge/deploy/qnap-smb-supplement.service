[Unit]
Description=FA production read-only QNAP supplement
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qnap-supplement
Group=qnap-supplement
WorkingDirectory=/opt/qnap-smb-supplement
Environment=QACS_SERVER_CONFIG=/etc/qnap-smb-supplement/config.json
ExecStart=/usr/local/bin/bun /opt/qnap-smb-supplement/src/production-server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
